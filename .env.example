# ----------------------------------------------------------------------------
# Supabase market-data connection
# ----------------------------------------------------------------------------
# Copy this file to ".env" in the repository root and fill in YOUR values.
# Where to find them: Supabase Dashboard -> Project Settings -> API
#   - SUPABASE_URL = "Project URL"
#   - SUPABASE_KEY = anon key (read-only) or service_role key
#
# The dashboard/API picks this up automatically: candles will be loaded from
# your Supabase table whenever the local data folder has no matching bars
# (priority: local data folder -> Supabase -> Yahoo -> synthetic).
#
# Expected table (run once in the Supabase SQL editor):
#
#   create table if not exists candles (
#       symbol    text        not null,
#       timeframe text        not null,
#       time      bigint      not null,
#       open      double precision not null,
#       high      double precision not null,
#       low       double precision not null,
#       close     double precision not null,
#       volume    double precision default 0,
#       spread    double precision default 0,
#       primary key (symbol, timeframe, time)
#   );

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_TABLE=candles
# ----------------------------------------------------------------------------
# MetaTrader 5 terminal (optional)
# ----------------------------------------------------------------------------
# Used when the data-source chain reaches MT5 (auto mode tries MT5 first
# while a terminal is running). Point MT5_PATH at terminal64.exe if it is
# not installed in the default location; fill in the account fields only
# for logging into a specific (DEMO) account.
# for the path go start menu search for the terminal u want to use then
# Right click -> open in folders -> Properties -> copy the target location and past it below
MT5_PATH="Your MT5 terminal_Path" 
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ----------------------------------------------------------------------------
# Supabase PERSISTENT STORAGE (trades, strategy versions, experiments)
# ----------------------------------------------------------------------------
# When set, the API server persists journal/versions/experiments through
# PostgresStore (works with Supabase's hosted Postgres). Find these in
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
